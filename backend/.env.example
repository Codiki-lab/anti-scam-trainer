TRUSTED_PROXY_CIDRS=172.16.0.0/12
RATE_LIMIT_REGISTER_CAPACITY=5
RATE_LIMIT_REGISTER_WINDOW=10m
RATE_LIMIT_LOGIN_CAPACITY=10
RATE_LIMIT_LOGIN_WINDOW=10m
RATE_LIMIT_AI_CAPACITY=10
